# Backend
PASARPULSE_MODE=auto
PASARPULSE_FORECAST_PATH=
PASARPULSE_EVIDENCE_PATH=
PASARPULSE_GEOGRAPHY_PATH=
PASARPULSE_MANIFEST_PATH=
PASARPULSE_WARNING_WATCH=5
PASARPULSE_WARNING_ELEVATED=10
PASARPULSE_WARNING_HIGH=15

# Optional grounded Gemini Copilot. Never commit a real key.
PASARPULSE_LLM_API_KEY=
PASARPULSE_LLM_MODEL=gemini-3.5-flash-lite
PASARPULSE_GEMINI_THINKING_LEVEL=high
PASARPULSE_LLM_TIMEOUT_SECONDS=20

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
